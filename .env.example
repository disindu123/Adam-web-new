NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Firebase project settings > General > Web API key. Enable Email/Password Auth.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_API_KEY=your-web-api-key
# Server credentials only. Set either the JSON variable OR application credentials.
# Keep the JSON on one line. Never commit actual credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative: absolute path to a private service-account file outside public/.
GOOGLE_APPLICATION_CREDENTIALS=

# Set NODE_ENV=production and SITE_URL=https://adamx.com on your server.
# With one trusted reverse proxy (Render, nginx, etc.), use 1. Otherwise use 0.
TRUST_PROXY=0
